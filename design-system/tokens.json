{
  "$description": "Whiteboard Wednesdays design system: Idea Cards (board 07 'Trading cards' of the Video Ideas Board canvas, chosen by Taylor on 21 November 2026). The live values are the --ww-* custom properties at the top of public/whiteboard.css; this file mirrors them. Change both together.",
  "$source": "public/whiteboard.css",
  "color": {
    "surface":        { "$value": "#FFFFFF", "css": "--ww-surface", "use": "The page and every card." },
    "ink":            { "$value": "#1B1B1F", "css": "--ww-ink", "use": "Text, card edges, control edges, primary buttons, focus ring. 17.2:1 on white." },
    "on-ink":         { "$value": "#FFFFFF", "css": "--ww-on-ink", "use": "Text on ink." },
    "ink-hover":      { "$value": "#3A3A42", "css": "--ww-ink-hover" },
    "body-ink":       { "$value": "#46454F", "css": "--ww-body-ink", "use": "Card body text. 9.4:1 on white." },
    "muted":          { "$value": "#5B5A57", "css": "--ww-muted", "use": "Eyebrows, captions, secondary text. 6.9:1 on white, 6.2:1 on stage." },
    "faint":          { "$value": "#8C877E", "css": "--ww-faint", "use": "Dashed edges of small placeholders only; never body text. 3.6:1 on white." },
    "dash":           { "$value": "#B8B4AC", "css": "--ww-dash", "use": "The dashed edge of '+ add' placeholders (decoration; the label carries the meaning)." },
    "stage":          { "$value": "#F4F2EE", "css": "--ww-stage", "use": "Soft grey rows, empty tiles, today's cell, boards." },
    "stage-soft":     { "$value": "#F9F8F5", "css": "--ww-stage-soft" },
    "line":           { "$value": "#E4E1DA", "css": "--ww-line", "use": "Dividers inside a card; decoration only." },
    "sky":            { "$value": "#7AD3FF", "css": "--ww-sky", "use": "Hero offset shadow, tile 1, the accent bar, today, running stage bar. Fill only; ink on sky is 10.3:1." },
    "pink":           { "$value": "#FFB4D2", "css": "--ww-pink", "use": "Tile 2, a second kind of card. Ink on pink 10.4:1." },
    "mint":           { "$value": "#A8E6B4", "css": "--ww-mint", "use": "Tile 3, done states. Ink on mint 12.0:1." },
    "sun":            { "$value": "#FFE27A", "css": "--ww-sun", "use": "The NEW chip, the chosen state (with an ink edge), posting, highlights. Ink on sun 13.4:1." },
    "sky-wash":       { "$value": "#E8F7FF", "css": "--ww-sky-wash", "use": "Card art panels." },
    "pink-wash":      { "$value": "#FFEAF2", "css": "--ww-pink-wash" },
    "mint-wash":      { "$value": "#E6F7EA", "css": "--ww-mint-wash" },
    "sun-wash":       { "$value": "#FFF6D1", "css": "--ww-sun-wash" },
    "accent":         { "$value": "{color.sky}", "css": "--ww-accent", "use": "Marks and bars (was the gold measuring mark)." },
    "accent-ink":     { "$value": "#0B5E8A", "css": "--ww-accent-ink", "use": "Text in the accent (the current week's date and similar). 7.0:1 on white." },
    "focus":          { "$value": "{color.ink}", "css": "--ww-focus", "use": "3px focus ring, 3px offset." },
    "highlight":      { "$value": "{color.sun}", "css": "--ww-highlight" },
    "logo-band":      { "$value": "#F6DF8C", "css": "--ww-logo-band", "use": "The logo's marker band only; unchanged by the rebrand." },
    "success":        { "$value": "#1E6B45", "css": "--ww-success", "use": "Status lines only, with the diamond and the words. 6.5:1." },
    "warn":           { "$value": "#9A3412", "css": "--ww-warn", "use": "Status lines only, with the diamond and the words. 7.3:1." },
    "legacy-gold":    { "$value": "#8B6002", "css": "--ww-gold", "use": "Legacy: the Presentations wall's Caveat notes and gold tack only. Not for new work." }
  },
  "font": {
    "family": {
      "sans":  { "$value": "WWRubik, 'Helvetica Neue', Arial, sans-serif", "css": ["--ww-font-body", "--ww-font-display", "--ww-font-label", "--ww-font-mono"], "file": "public/ww-rubik.ttf (variable, wght 300-900), public/ww-rubik-italic.ttf; licence public/ww-rubik-license.txt (SIL OFL 1.1)" },
      "hand":  { "$value": "WWHand, cursive", "css": "--ww-font-hand", "use": "Caveat: the Presentations wall and the Topics board's handwritten parts only." }
    },
    "weight": {
      "body":    { "$value": 400, "css": "--ww-body-weight" },
      "control": { "$value": 500, "css": "--ww-control-weight", "use": "Buttons, tabs, rows." },
      "strong":  { "$value": 700, "css": "--ww-strong-weight", "use": "Eyebrows, card footers, small headings, figures." },
      "display": { "$value": 800, "css": "--ww-display-weight", "use": "Page titles, card titles, numbered tiles." }
    },
    "size": {
      "title":   { "$value": "clamp(34px, 3.6vw, 46px)", "css": "--ww-size-title", "tracking": "-0.02em", "weight": 800 },
      "h2":      { "$value": "26px", "css": "--ww-size-h2", "tracking": "-0.015em" },
      "card":    { "$value": "28px", "use": "Hero card title, weight 800, line-height 1.05" },
      "h3":      { "$value": "20px", "css": "--ww-size-h3" },
      "h4":      { "$value": "18px", "css": "--ww-size-h4" },
      "body":    { "$value": "16px", "css": "--ww-size-body", "lineHeight": 1.5 },
      "eyebrow": { "$value": "13px", "css": "--ww-size-eyebrow", "tracking": "0.12em", "weight": 700, "case": "upper" },
      "micro":   { "$value": "12px", "css": "--ww-size-micro", "tracking": "0.12em", "weight": 700, "case": "upper", "use": "Labels, dates, counts. Never under 11px." },
      "read":    { "$value": "19px", "css": "--ww-size-read" },
      "read-record": { "$value": "24px", "css": "--ww-size-read-record" }
    }
  },
  "radius": {
    "mark":    { "$value": "4px",   "css": "--ww-radius-mark" },
    "tile":    { "$value": "10px",  "css": "--ww-radius-tile", "use": "Numbered tiles, small squares." },
    "control": { "$value": "12px",  "css": "--ww-radius-control", "use": "Buttons, fields, count pills." },
    "media":   { "$value": "14px",  "css": "--ww-radius-media", "use": "Thumbnails and images inside cards." },
    "inner":   { "$value": "16px",  "css": "--ww-radius-inner", "use": "Rows and art panels inside a card." },
    "card":    { "$value": "22px",  "css": ["--ww-radius-card", "--ww-radius-panel"] },
    "hero":    { "$value": "26px",  "css": ["--ww-radius-hero", "--ww-radius-board"] },
    "pill":    { "$value": "999px", "css": ["--ww-radius-pill", "--ww-radius-chip", "--ww-radius-badge"] },
    "round":   { "$value": "50%",   "css": "--ww-radius-round", "use": "Avatars and lamps." }
  },
  "border": {
    "card":           { "$value": "3px solid #1B1B1F", "css": "--ww-edge-card" },
    "hero":           { "$value": "4px solid #1B1B1F", "css": "--ww-edge-hero" },
    "control":        { "$value": "2px solid #1B1B1F", "css": "--ww-edge-control" },
    "dashed":         { "$value": "3px dashed #B8B4AC", "css": "--ww-edge-dashed", "use": "'+ add' placeholders and empty states." },
    "dashed-control": { "$value": "2px dashed #8C877E", "css": "--ww-edge-dashed-control" },
    "ledger":         { "$value": "3px solid #1B1B1F", "css": "--ww-ledger", "use": "The rule that heads the calendar and the tab bar." },
    "accent":         { "$value": "4px solid #7AD3FF", "css": ["--ww-rule-accent", "--ww-rule-gold"] }
  },
  "shadow": {
    "hero":  { "$value": "10px 10px 0 #7AD3FF", "css": "--ww-shadow-hero", "use": "One hero card per screen." },
    "card":  { "$value": "6px 6px 0 var(--ww-pop)", "css": "--ww-shadow-card", "use": "A lifted, open or chosen card. --ww-pop defaults to sky; set it to pink, mint or sun per card." },
    "small": { "$value": "4px 4px 0 var(--ww-pop)", "css": "--ww-shadow-small" },
    "ink":   { "$value": "4px 4px 0 #1B1B1F", "css": "--ww-shadow-ink" }
  },
  "transform": {
    "tilt":      { "$value": "-2deg", "css": "--ww-tilt", "use": "Hero cards; .ww-card--hero straightens on hover and focus (instantly under reduced motion)." },
    "tilt-soft": { "$value": "-1deg", "css": "--ww-tilt-soft" }
  }
}
