{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "spec.schema.json",
  "title": "Thumbnail spec for scripts/render.cjs",
  "description": "A render spec: {thumbnails:[...]}. Common fields follow references/design/spec.md. Unknown thumbnail fields are warnings (x-warnUnknown), not errors.",
  "type": "object",
  "required": [
    "thumbnails"
  ],
  "properties": {
    "thumbnails": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/thumbnail"
      }
    },
    "out": {
      "type": "string"
    },
    "keep_html": {
      "type": "boolean"
    },
    "_note": {
      "type": "string"
    }
  },
  "definitions": {
    "thumbnail": {
      "type": "object",
      "required": [
        "id",
        "archetype"
      ],
      "x-warnUnknown": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "description": "Output file name (no extension). Letters, digits, dot, dash, underscore."
        },
        "title": {
          "type": "string",
          "description": "YouTube title shown under the thumbnail in the feed preview."
        },
        "archetype": {
          "enum": [
            "verdict",
            "equation",
            "command",
            "proof",
            "syllabus",
            "marker",
            "versus",
            "social",
            "trend",
            "repo",
            "caption",
            "split",
            "quote",
            "scene"
          ]
        },
        "theme": {
          "enum": [
            "light",
            "cream",
            "dark",
            "purple",
            "green",
            "red"
