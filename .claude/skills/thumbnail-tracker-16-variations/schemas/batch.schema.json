{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "batch.schema.json",
 "title": "Packaging batch for scripts/package.py",
 "type": "object",
 "required": [
  "video",
  "titles",
  "thumbnails"
 ],
 "x-warnUnknown": true,
 "properties": {
  "video": {
   "type": "object",
   "required": [
    "title_working"
   ],
   "properties": {
    "title_working": {
     "type": "string",
     "minLength": 1
    },
    "slug": {
     "type": "string",
     "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "duration": {
     "type": "string",
     "pattern": "^(\\d+:)?\\d{1,2}:\\d{2}$"
    },
    "summary": {
     "type": "string"
    },
    "url": {
     "type": "string"
    }
   }
  },
  "titles": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "text"
    ],
    "properties": {
     "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
     },
     "formula": {
      "type": "string"
     },
     "style": {
      "type": "string"
     },
     "intent": {
      "enum": [
       "search",
       "browse",
       "both"
      ]
     },
     "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
     }
    }
   }
  },
  "thumbnails": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "spec.schema.json#/definitions/thumbnail"
   }
  },
  "descriptions": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "text"
    ],
    "properties": {
     "style": {
      "type": "string"
     },
     "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
     }
    }
   }
  },
  "linkedin": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "text"
    ],
    "properties": {
     "angle": {
      "type": "string"
     },
     "pair": {
      "type": "integer",
      "minimum": 0
     },
     "mode": {
      "enum": [
       "native",
       "link"
      ]
     },
     "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
     }
    }
   }
  },
  "ab": {
   "type": "object",
   "properties": {
    "titles": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 0
     }
    },
    "thumbnails": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "notes": {
   "type": [
    "string",
    "array"
   ]
  },
  "created": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "brand": {
   "type": [
    "string",
    "object"
   ],
   "description": "Brand profile name/path or inline profile (brand.schema.json)."
  },
  "problems": {
   "type": "array"
  },
  "placeholders": {
   "type": "array"
  },
  "warnings": {
   "type": "array"
  },
  "_note": {
   "type": "string"
  }
 }
}